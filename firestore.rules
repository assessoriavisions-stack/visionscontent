rules_version = '2';

// Plataforma de Roteiros Visions
// - admin: custom claim admin == true ou documento admins/{uid} (criado à mão no Console)
// - cliente: lê/escreve só os próprios dados, e só enquanto clientes/{uid}.status == "ativo"
// - conteúdo gerado pela IA, status, limites e diagnósticos são escritos só pelas Cloud Functions (Admin SDK)
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    // Admin: custom claim admin == true OU documento admins/{uid}, criado à mão no Console.
    function isAdmin() {
      return logado() && (request.auth.token.admin == true
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function isDono(uid) { return logado() && request.auth.uid == uid; }
    function clienteAtivo(uid) {
      return get(/databases/$(database)/documents/clientes/$(uid)).data.status == "ativo";
    }
    // O cliente só acessa os próprios dados enquanto estiver ativo.
    function podeAcessar(uid) { return isDono(uid) && clienteAtivo(uid); }

    // Limites do DNA: só campos conhecidos e listas de tamanho razoável.
    function dnaValido(d) {
      let tom = d.get('tom', {});
      return d.keys().hasOnly(['negocio', 'tom', 'expressoesQueUsa', 'palavrasProibidas', 'temaPrincipal',
                               'subtemas', 'atualizadoEm', 'etapaOnboarding', 'onboardingConcluido'])
        && d.get('negocio', {}) is map
        && tom is map
        && tom.get('exemplosReais', []).size() <= 5
        && tom.get('perfilDeVozExtraido', '').size() <= 4000
        && d.get('expressoesQueUsa', []).size() <= 30
        && d.get('palavrasProibidas', []).size() <= 60
        && d.get('subtemas', []).size() <= 20
        && d.get('temaPrincipal', '').size() <= 200;
    }

    function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function naoMexeEm(campos) { return !mudou().hasAny(campos); }

    // ---------- admins: criados só pelo Console do Firebase ----------
    match /admins/{uid} {
      allow read: if isDono(uid);
      allow write: if false;
    }

    // ---------- config e logs: só admin ----------
    match /config/{doc} {
      allow read, write: if isAdmin();
    }
    match /logs/{caminho=**} {
      allow read, write: if isAdmin();
    }

    // ---------- clientes ----------
    match /clientes/{uid} {
      allow read: if isAdmin() || podeAcessar(uid);
      // Criação, status, vencimento, limite e contador passam pelas functions.
      // O cliente só pode atualizar os próprios tokens de push.
      allow update: if podeAcessar(uid) && mudou().hasOnly(['fcmTokens']);
      allow create, delete: if false;

      // Leitura do admin em qualquer subcoleção.
      match /{sub}/{docId} {
        allow read: if isAdmin();
      }

      match /dna/{docId} {
        allow read: if podeAcessar(uid);
        allow write: if podeAcessar(uid) && docId == 'atual' && dnaValido(request.resource.data);
      }

      match /roteiros/{id} {
        allow read: if podeAcessar(uid);
        // Criado pela function gerarRoteiro.
        allow create: if false;
        // Edição do cliente no editor; status "postado"/"medido" e a trava ficam com as functions.
        allow update: if podeAcessar(uid)
          && naoMexeEm(['trava', 'criadoEm', 'formato', 'pilar', 'campanhaId', 'serieId', 'parteSerie', 'temaSugeridoPelaIA'])
          && request.resource.data.status in ['rascunho', 'pronto']
          && resource.data.status in ['rascunho', 'pronto'];
        allow delete: if podeAcessar(uid) && resource.data.status in ['rascunho', 'pronto'];
      }

      match /posts/{id} {
        // Criados por marcarPostado e atualizados por salvarMetricas.
        allow read: if podeAcessar(uid);
        allow write: if false;
      }

      match /campanhas/{id} {
        allow read: if podeAcessar(uid);
        allow create: if false;
        // Reorganizar datas no calendário.
        allow update: if podeAcessar(uid) && naoMexeEm(['criadoEm']);
        allow delete: if podeAcessar(uid);
      }

      match /notificacoes/{id} {
        allow read: if podeAcessar(uid);
        allow update: if podeAcessar(uid) && mudou().hasOnly(['lida']);
        allow create, delete: if false;
      }
    }

    // Todo o resto: fechado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
